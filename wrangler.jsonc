{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notice-board",
  "compatibility_date": "2026-10-01",
  // Static-only site: Workers Static Assets serves ./dist, no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // zone akibh.dev is on Cloudflare, so the custom domain is created on deploy
  "routes": [{ "pattern": "board.akibh.dev", "custom_domain": true }]
}
