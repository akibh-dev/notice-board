---
/**
 * @file layout/BrandLogo.astro
 * @description Animated Paint-Fill "A" brand logo — light + dark variants.
 *
 * SOURCE (reproduced 1:1):
 *   - assets/Paint-Fill A-html--white/Main.dc.html  → light variant
 *   - assets/Paint-Fill A — Dark-html/Dark.dc.html  → dark variant
 * The SVG and its pure-CSS keyframe choreography are lifted EXACTLY from
 * those exports: same viewBox="0 0 600 600", same path data, same colors,
 * same stroke-width="4" outline, same timings — a 1s pop intro, then five
 * rainbow paint layers sweep left→right across the clipped glyph,
 * staggered 140ms apart starting at t=1s; the final layer (BLACK in the
 * light variant, WHITE in the dark one) lands at t=1.7s; the rainbow
 * group fades at t=3.35s, leaving the monochrome A. The dark variant's
 * outline additionally cross-fades #737373 → #FFFFFF in sync with the
 * final layer. The exports' react.js/support.js are only the design
 * tool's preview-page boilerplate — the animation needs no JavaScript,
 * so this component ships zero JS and plays on first paint.
 *
 * WHY TWO SVGs (not one recolored): the variants are NOT recolors of
 * each other — light starts as a WHITE A and fills BLACK under a
 * constant black outline; dark starts as a zinc-900 (#18181B) A, fills
 * WHITE, and its outline animates gray→white. Both variants are inlined
 * and swapped with Tailwind's `dark:` variant (.dark is set on <html>
 * before first paint → no flash of the wrong logo). Deliberate side
 * effect: display:none pauses CSS animations, so every theme toggle
 * REPLAYS the full intro + paint sweep on the newly shown variant.
 *
 * WHY NO WRAPPER BOX: an earlier iteration sat the logo inside the
 * sidebar's bordered rounded-md chip, but the chrome rectangle fights
 * the artwork — the source A is designed to float directly on the page
 * (its preview stages are plain #E7E4DD / #09090B fields). Here it
 * floats on the site's own canvas the same way.
 *
 * NECESSARY DEVIATIONS FROM SOURCE (invisible — required for embedding):
 *  1. Class names, keyframe names and clipPath ids are prefixed
 *     (logo-a-*): both variants live in ONE document, so the source's
 *     bare names (.pop, .l0–.l5, .colors, .ol, #aClip, intro/sweep/gone/ol)
 *     would collide with each other and could collide with site CSS.
 *  2. The fixed width="560" height="560" attributes become class-driven
 *     sizing via the `class` prop — the viewBox is unchanged, so the
 *     artwork scales losslessly to any size.
 *  3. The preview background divs (#E7E4DD / #09090B) are dropped — see
 *     WHY NO WRAPPER BOX above.
 *  4. role="img" + aria-label become aria-hidden — the logo renders
 *     inside a link whose adjacent text already names the site.
 *  5. clipPath ids also carry a per-INSTANCE suffix (logo-a-clip-dark-x7k2q9).
 *     With one shared id, url(#…) resolves to the FIRST match in the
 *     document; once the mobile header (display:none on desktop) rendered
 *     a logo before the sidebar's, every logo pointed at that hidden
 *     clipPath, the clip failed and the desktop A became a white square.
 *
 * Reduced motion: jumps straight to the final filled A (rainbow hidden,
 * last layer parked at its end position, dark outline already white) —
 * the same end state the source's own reduced-motion block produces.
 */

interface Props {
  /** Size utilities applied to both variant SVGs, e.g. "size-9". */
  class?: string;
}

const { class: size = "size-8" } = Astro.props;

// unique per rendered instance — see deviation 5. Frontmatter runs once
// per render, so a short random token is enough (static build: fixed in HTML)
const uid = Math.random().toString(36).slice(2, 8);

/* Geometry below is source 1:1 — do not "fix" values; the animation
   timings in <style> are tuned to exactly these shapes. */
const A_PATH =
  "M235 60 L365 60 L535 540 L405 540 L373.2 450 L226.8 450 L195 540 L65 540 Z M300 243.5 L341.3 360 L258.7 360 Z";

/* The five rainbow layers — identical in both variants. Each sweeps the
   same distance (-140px → 640px); only the delay differs (see <style>). */
const RAINBOW_LAYERS: { fill: string; d: string; splatter: [number, number, number][] }[] = [
  {
    fill: "#FF2E93",
    d: "M-1400 -20 L30 -20 C80 50 -20 110 25 190 C70 270 5 330 45 410 C85 490 0 560 40 640 L-1400 640 Z",
    splatter: [
      [110, 120, 8],
      [150, 260, 5],
      [95, 350, 10],
      [135, 470, 6],
      [120, 545, 4],
    ],
  },
  {
    fill: "#FF7A1A",
    d: "M-1400 -20 L10 -20 C-30 60 60 120 20 200 C-20 280 50 340 15 420 C-20 500 55 570 25 640 L-1400 640 Z",
    splatter: [
      [80, 200, 6],
      [70, 420, 7],
    ],
  },
  {
    fill: "#FFD21F",
    d: "M-1400 -20 L40 -20 C0 70 70 130 30 210 C-10 290 60 350 35 430 C10 510 60 580 20 640 L-1400 640 Z",
    splatter: [],
  },
  {
    fill: "#2ED47A",
    d: "M-1400 -20 L20 -20 C70 60 -10 130 30 200 C65 270 0 340 25 420 C55 500 5 570 35 640 L-1400 640 Z",
    splatter: [],
  },
  {
    fill: "#19B5FE",
    d: "M-1400 -20 L35 -20 C-10 50 55 120 15 205 C-25 285 45 345 30 425 C15 505 60 575 10 640 L-1400 640 Z",
    splatter: [],
  },
];

/* The final monochrome layer — geometry shared; the FILL is what makes
   the light variant end black and the dark variant end white. */
const FINAL_LAYER_D =
  "M-1400 -20 L15 -20 C55 60 -15 125 20 205 C55 285 -5 345 30 425 C60 505 5 575 30 640 L-1400 640 Z";

/* Per-variant differences ONLY: base fill, final fill, outline behavior,
   and which theme each one is visible in (`dark:` on <html>). */
const VARIANTS = [
  { id: "light", visibility: "block dark:hidden", baseFill: "#FFFFFF", finalFill: "#000000", outlineStroke: "#000000", outlineClass: undefined },
  { id: "dark", visibility: "hidden dark:block", baseFill: "#18181B", finalFill: "#FFFFFF", outlineStroke: "#737373", outlineClass: "logo-a-outline" },
] as const;
---

{
  VARIANTS.map((v) => (
    <svg class:list={[size, v.visibility]} viewBox="0 0 600 600" aria-hidden="true">
      <defs>
        <clipPath id={`logo-a-clip-${v.id}-${uid}`}>
          <path clip-rule="evenodd" d={A_PATH} />
        </clipPath>
      </defs>
      <g class="logo-a-pop">
        <path fill-rule="evenodd" fill={v.baseFill} d={A_PATH} />
        <g clip-path={`url(#logo-a-clip-${v.id}-${uid})`}>
          <g class="logo-a-colors">
            {RAINBOW_LAYERS.map((layer, i) => (
              <g class={`logo-a-layer logo-a-l${i}`}>
                <path fill={layer.fill} d={layer.d} />
                {layer.splatter.map(([cx, cy, r]) => (
                  <circle cx={cx} cy={cy} r={r} fill={layer.fill} />
                ))}
              </g>
            ))}
          </g>
          <g class="logo-a-layer logo-a-l5">
            <path fill={v.finalFill} d={FINAL_LAYER_D} />
          </g>
        </g>
        <path class={v.outlineClass} fill-rule="evenodd" fill="none" stroke={v.outlineStroke} stroke-width="4" d={A_PATH} />
      </g>
    </svg>
  ))
}

<style>
  /* Choreography timings lifted 1:1 from the source exports; names are
     prefixed logo-a-* because both variants share one document (Astro
     additionally hash-scopes the keyframes, so collisions are impossible).
     Sequence: pop (0–1s) → five staggered rainbow sweeps (1–3.3s) → final
     monochrome layer (from 1.7s) → rainbow fades at 3.35s. */
  .logo-a-pop {
    transform-box: view-box;
    transform-origin: 300px 300px;
    animation: logo-a-intro 1s both;
  }
  .logo-a-layer {
    animation: logo-a-sweep 1.6s cubic-bezier(0.55, 0, 0.25, 1) both;
  }
  .logo-a-l0 { animation-delay: 1s; }
  .logo-a-l1 { animation-delay: 1.14s; }
  .logo-a-l2 { animation-delay: 1.28s; }
  .logo-a-l3 { animation-delay: 1.42s; }
  .logo-a-l4 { animation-delay: 1.56s; }
  .logo-a-l5 { animation-delay: 1.7s; }
  .logo-a-colors { animation: logo-a-gone 0.01s linear 3.35s forwards; }
  .logo-a-outline { animation: logo-a-stroke 1.6s ease-in-out 1.7s both; }

  @keyframes logo-a-intro {
    0% { opacity: 0; transform: scale(1); animation-timing-function: ease-out; }
    50% { opacity: 1; transform: scale(1.07); animation-timing-function: ease-in-out; }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes logo-a-sweep {
    from { transform: translateX(-140px); }
    to { transform: translateX(640px); }
  }
  @keyframes logo-a-gone {
    to { opacity: 0; }
  }
  @keyframes logo-a-stroke {
    from { stroke: #737373; }
    to { stroke: #ffffff; }
  }

  /* Reduced motion: the source's end state, instantly — rainbow hidden,
     final layer parked at its swept position, dark outline already white. */
  @media (prefers-reduced-motion: reduce) {
    .logo-a-pop,
    .logo-a-layer,
    .logo-a-colors,
    .logo-a-outline {
      animation: none;
    }
    .logo-a-colors { display: none; }
    .logo-a-l5 { transform: translateX(640px); }
    .logo-a-outline { stroke: #ffffff; }
  }
</style>
