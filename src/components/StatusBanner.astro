---
import { dataset, sourceMeta } from '../lib/data';
const problems = dataset.sources.filter((s) => !s.ok);
const updated = dataset.generatedAt;
---
<p class="muted">Last updated <time datetime={updated}>{new Date(updated).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Dhaka' })}</time> (BST)</p>
{problems.map((s) => (
  <p class="warn" role="status">
    {sourceMeta(s.id)?.name ?? s.id}: {s.stale ? 'could not refresh — showing older notices.' : 'currently unavailable.'}
  </p>
))}
