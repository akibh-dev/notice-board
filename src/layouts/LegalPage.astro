---
/**
 * Shell for /privacy/ and /terms/: the board's Layout plus a readable prose
 * column. Prose styles are `:global` because slot content keeps the PAGE's
 * style scope (same approach as akibh.dev's LegalPage, one small rule set
 * instead of a typography plugin).
 */
import Layout from './Layout.astro';

interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
const updatedText = new Date(updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout title={title} description={description}>
  <header class="border-b border-line px-5 py-8 md:px-8 md:py-10">
    <p class="mb-3 font-mono text-2xs uppercase tracking-widest text-muted"><a href="/" class="hover:text-accent">← Notices</a></p>
    <h1 class="font-display text-[clamp(2rem,3vw+1rem,3rem)] leading-[1.05] tracking-tight">{title}<span class="text-accent">.</span></h1>
    <p class="mt-3 font-mono text-2xs uppercase tracking-widest text-muted">Last updated <time datetime={updated}>{updatedText}</time></p>
  </header>
  <article class="legal px-5 py-8 md:px-8 md:py-10"><slot /></article>
</Layout>

<style>
  .legal { max-width: 68ch; font-size: 0.9375rem; line-height: 1.7; color: var(--color-subtle); }
  .legal :global(h2) { margin: 2.5rem 0 0.75rem; font-family: var(--font-display); font-size: 1.375rem; line-height: 1.25; color: var(--color-default); }
  .legal :global(h2:first-child) { margin-top: 0; }
  .legal :global(p), .legal :global(ul) { margin: 0 0 1rem; }
  .legal :global(ul) { padding-left: 1.25rem; list-style: disc; }
  .legal :global(li) { margin: 0.35rem 0; }
  .legal :global(li::marker) { color: var(--color-muted); }
  .legal :global(strong) { color: var(--color-default); font-weight: 600; }
  .legal :global(code) { font-family: var(--font-mono); font-size: 0.85em; color: var(--color-default); }
  .legal :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .legal :global(a:hover) { color: var(--color-accent-hover); }
  .legal :global(.summary) { margin-bottom: 2rem; border-left: 2px solid var(--color-accent); padding: 0.25rem 0 0.25rem 1rem; color: var(--color-default); }
</style>
