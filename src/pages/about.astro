---
import Base from '../layouts/Base.astro';
import { sources } from '../sources';
---
<Base title="About">
  <h1>About</h1>
  <p>Notice Board collects public recruitment circulars from Bangladesh government portals and lists them in one searchable place. The page is rebuilt automatically and every item links to the original notice.</p>
  <h2>Sources</h2>
  <ul class="plain">{sources.map((s) => <li><a href={`/source/${s.id}`}>{s.name}</a> — <a href={s.homepage} rel="noopener noreferrer">official site ↗</a></li>)}</ul>
  <h2>Disclaimer</h2>
  <p>This site is not affiliated with any government body. Information may be delayed or incomplete — confirm deadlines and eligibility on the official notice.</p>
</Base>
