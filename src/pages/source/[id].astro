---
import Base from '../../layouts/Base.astro';
import NoticeList from '../../components/NoticeList.astro';
import StatusBanner from '../../components/StatusBanner.astro';
import { sources } from '../../sources';
import { dataset } from '../../lib/data';
export const getStaticPaths = () => sources.map((s) => ({ params: { id: s.id }, props: { s } }));
const { s } = Astro.props;
---
<Base title={s.name}>
  <p class="muted"><a href="/">← All notices</a></p>
  <h1>{s.name}</h1>
  <p><a href={s.homepage} rel="noopener noreferrer">Official site ↗</a></p>
  <StatusBanner />
  <NoticeList notices={dataset.notices.filter((n) => n.sourceId === s.id)} showSourceFilter={false} />
</Base>
