{
  "name": "notice-board",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fetch": "tsx scripts/fetch.ts",
    "fetch:bb": "tsx scripts/fetch.ts --source bb-erecruitment",
    "fetch:teletalk": "tsx scripts/fetch.ts --source teletalk-alljobs",
    "fetch:fixtures": "tsx scripts/fetch.ts --fixtures",
    "prepare:commit": "npm run fetch && npm run check && npm test && npm run build",
    "data:build": "tsx scripts/build-data.ts",
    "dev": "npm run data:build && astro dev",
    "build": "npm run data:build && astro build",
    "build:full": "npm run build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "deploy": "npm run build:full && wrangler pages deploy dist --project-name=notice-board --branch=main"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "cheerio": "^1.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
