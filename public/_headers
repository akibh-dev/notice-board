# Cloudflare static-assets response headers (same policy as blog.akibh.dev).
# HSTS is set at the zone level. /_astro/* and /fonts/* are immutable.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# no-transform: stops Cloudflare injecting an unhashable inline script that the CSP <meta> would block
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/notices.json
  Cache-Control: public, max-age=300
